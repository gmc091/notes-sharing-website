// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Note {
  id            Int           @id @default(autoincrement())
  title         String
  schools       String[]
  subjects      String[]
  years         Int[]
  filePaths     String[]
  createdAt     DateTime      @default(now())
  userId        String        // Clerk user ID
  isAnonymous   Boolean       @default(false)
  purchaseCount Int           @default(0)  // Changed from viewCount to better reflect the system
  purchases     NotePurchase[] // Renamed from views to better reflect the functionality
  user          User          @relation(fields: [userId], references: [clerkId])
}

model User {
  id               Int            @id @default(autoincrement())
  clerkId          String         @unique // Clerk user ID
  points           Int            @default(5) // Starting points
  showInLeaderboard Boolean       @default(true)
  notes            Note[]         // Notes uploaded by user
  purchases        NotePurchase[] // Notes purchased by user
  pointTransactions PointTransaction[]
}

model NotePurchase {
  id          Int      @id @default(autoincrement())
  noteId      Int
  userId      String   // Clerk user ID
  purchasedAt DateTime @default(now())
  note        Note     @relation(fields: [noteId], references: [id])
  user        User     @relation(fields: [userId], references: [clerkId])

  @@unique([noteId, userId])
}

model PointTransaction {
  id          Int      @id @default(autoincrement())
  userId      String   // Clerk user ID
  amount      Int      // Can be positive or negative
  type        String   // "PURCHASE", "UPLOAD_REWARD", "MONTHLY_BONUS"
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [clerkId])
}